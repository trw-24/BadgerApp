# Environment variables for Docker Compose development setup
# Copy this file to .env and customize as needed

# Database Configuration
POSTGRES_DB=badgers
POSTGRES_USER=badger_admin
POSTGRES_PASSWORD=BadgerPass123!
DATABASE_URL=postgresql://badger_admin:BadgerPass123!@postgres:5432/badgers

# Redis Configuration  
REDIS_URL=redis://redis:6379

# Application Configuration
SECRET_KEY=badger-secret-key-2023-dev
FLASK_ENV=development
DEBUG=true
BADGER_API=https://api.wildlifetrackers.com/badgers

# Admin Tools
PGADMIN_DEFAULT_EMAIL=admin@badgerdelivery.com
PGLADMIN_DEFAULT_PASSWORD=admin123

# Port Mappings (change if you have conflicts)
APP_PORT=5000
POSTGRES_PORT=5432
REDIS_PORT=6379
PGADMIN_PORT=8080
REDIS_COMMANDER_PORT=8081
